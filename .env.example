# ── REQUIRED ──────────────────────────────────────────────────────────

# Frigate URL (e.g., http://192.168.1.100:5000 or http://frigate:5000)
# Use the internal container name if running in the same Docker network.
FRIGATE_URL=http://frigate:5000

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Chat ID (your personal ID or group ID)
TELEGRAM_CHAT_ID=your_chat_id_here


# ── CAMERA / ZONE MONITORING ─────────────────────────────────────────

# Format (JSON): {"camera1": ["zone_a", "zone_b"], "camera2": ["all"]}
# Format (Legacy): camera1:zone_a,zone_b;camera2:all
# - Use 'all' for all zones in a camera.
# - Omit or leave empty to monitor ALL cameras and ALL zones.
MONITOR_CONFIG={"front_door": ["yard", "driveway"], "back_camera": ["all"]}

# Camera Health Monitoring (offline/disconnected alerts)
# Comma-separated or JSON list of cameras to monitor for health (0 fps / disconnects).
# Omit or leave empty to monitor ALL cameras returned by Frigate.
# HEALTH_MONITOR_CAMERAS=front_door,back_camera
# Alert when Frigate's /tmp/cache usage reaches this percent (1-100). A full
# cache means Frigate stopped saving recordings; a restart fixes it.
# HEALTH_CACHE_THRESHOLD_PCT=85

# Night-only alerts: restrict specific cameras (e.g. indoor cams) to only notify
# during a nightly window. Comma-separated camera list; empty/omit = feature off
# (those cameras are unaffected and notify anytime). Window may cross midnight
# (e.g. 22:00-06:00) and is interpreted in TIMEZONE (see below).
# Note: NIGHT_ALERT_CAMERAS is ANDed with MONITOR_CONFIG above — a camera excluded
# there will never notify, even if listed here and inside the window.
# NIGHT_ALERT_CAMERAS=indoor_hallway,indoor_living_room
# NIGHT_ALERT_START=22:00
# NIGHT_ALERT_END=06:00



# ── OPTIONAL / ADVANCED ───────────────────────────────────────────────

# Public Frigate URL (e.g., via Cloudflare Tunnel) for event links in Telegram
EXTERNAL_URL=https://cctv.example.com

# Frigate Basic Authentication (uncomment if enabled in Frigate)
# FRIGATE_USERNAME=admin
# FRIGATE_PASSWORD=password

# Polling interval in seconds (default: 60)
POLLING_INTERVAL=60

# Media fetching settings
MEDIA_WAIT_TIMEOUT=5    # Seconds to wait for Frigate to generate media
UPLOAD_TIMEOUT=60       # Seconds for Telegram upload timeout (increase for slow connections)
SEND_CLIP=false         # Set to 'true' to send HD mp4 clips instead of preview GIFs

# Localization & Appearance
TIMEZONE=UTC            # Timezone for notification timestamps (e.g., America/Chicago)
LOCALES=en-US           # Locale for formatting numbers/dates
DEBUG=false             # Set to 'true' for verbose logging

# State persistence path (defaults to /app/data/state.json inside container)
# STATE_FILE=/app/data/state.json
